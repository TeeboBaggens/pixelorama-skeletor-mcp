{
  "name": "pixelorama-skeletor-mcp",
  "version": "0.2.1",
  "description": "MCP server that bridges AI assistants with Pixelorama for pixel art creation, including skeletal rigging and animation via the Skeletor extension",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pixelorama-skeletor-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "keywords": [
    "mcp",
    "pixelorama",
    "pixel-art",
    "ai",
    "drawing",
    "model-context-protocol",
    "skeletor",
    "skeletal-animation",
    "rigging",
    "godot"
  ],
  "author": "pix-MCP Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TeeboBaggens/pixelorama-skeletor-mcp.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.14.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
